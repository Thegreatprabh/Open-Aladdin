# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Generate a strong password, e.g.: openssl rand -hex 24
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=open_atlas

# Shared password for FIX gateway Logon (tag 554). The gateway is
# FAIL-CLOSED: without this, every Logon is rejected. Set
# FIX_GATEWAY_DEV=1 only for local development (never in production).
# FIX_GATEWAY_PASSWORD=
